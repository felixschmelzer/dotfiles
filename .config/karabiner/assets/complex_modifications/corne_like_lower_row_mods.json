{
  "title": "Corne-like lower row hold-taps on built-in keyboard (German physical positions)",
  "rules": [
    {
      "description": "Lower row hold-tap modifiers like Corne on built-in keyboard using German key positions",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "z",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            { "key_code": "left_control", "lazy": true }
          ],
          "to_if_alone": [
            { "key_code": "z" }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                { "is_built_in_keyboard": true }
              ]
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 350,
            "basic.to_if_held_down_threshold_milliseconds": 350
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "x",
            "modifiers": { "optional": ["any"] }
          },
